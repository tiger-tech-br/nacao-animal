# ==================================================
# APLICACAO
# ==================================================

NODE_ENV=development
PORT=4501
APP_URL=http://localhost:4501
FRONTEND_URL=http://localhost:4501

# ==================================================
# BANCO DE DADOS POSTGRESQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=petflow_v2
# Nome que a aplicacao aceita. No Railway, use a referencia do Postgres novo:
# DB_EXPECTED_NAME=${{Postgres.PGDATABASE}}
DB_EXPECTED_NAME=petflow_v2
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres

# Railway pode usar DATABASE_URL no lugar das variaveis DB_* acima.
DATABASE_URL=
DB_SSL=false

# ==================================================
# AUTENTICACAO
# ==================================================

JWT_SECRET=troque_por_uma_chave_forte_e_grande
JWT_EXPIRES_IN=7d

# ==================================================
# ADMIN PADRAO PARA SEED
# ==================================================

ADMIN_NAME=Administrador
ADMIN_EMAIL=
# Minimo de 12 caracteres com maiuscula, minuscula, numero e simbolo.
ADMIN_PASSWORD=

# ==================================================
# CLOUDINARY
# ==================================================

CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# Limite de upload em bytes (inteiro positivo, ate 20 MB). Padrao: 5 MB.
MAX_FILE_SIZE=5242880

# ==================================================
# RESEND / EMAIL
# ==================================================

RESEND_API_KEY=sua_chave_resend
EMAIL_FROM=PetFlow <suporte@tigertech.dev.br>
EMAIL_TEST_TO=suporte@tigertech.dev.br

# ==================================================
# PAGSEGURO
# ==================================================

# Sandbox:
# PAGSEGURO_BASE_URL=https://sandbox.api.pagseguro.com

# Producao:
# PAGSEGURO_BASE_URL=https://api.pagseguro.com

PAGSEGURO_BASE_URL=https://sandbox.api.pagseguro.com
PAGSEGURO_TOKEN=seu_token_pagseguro

# FRETE: Google Maps Platform, Routes API habilitada, chave apenas no servidor.
GOOGLE_MAPS_API_KEY=
DELIVERY_ORIGIN_ADDRESS=Avenida Novo Horizonte, 123, Vila Sacadura Cabral, Santo André, SP, Brasil

# Chave publica restrita ao dominio; habilite Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=

# Tempo em que os itens ficam reservados enquanto o pagamento nao termina.
ORDER_RESERVATION_MINUTES=30

# Depois que sair para entrega, o cancelamento automatico so e permitido acima desta distancia do destino.
CANCELLATION_MIN_DISTANCE_METERS=1000
# O cancelamento e estorno automaticos sao limitados a 24 horas por regra do sistema.
