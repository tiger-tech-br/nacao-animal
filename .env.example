# ==================================================
# APLICACAO
# ==================================================

NODE_ENV=development
PORT=4600
APP_URL=http://localhost:4600
FRONTEND_URL=http://localhost:4600

# ==================================================
# BANCO DE DADOS POSTGRESQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nacao-animal
# Nome que a aplicacao aceita. No Railway, use a referencia do Postgres novo:
# DB_EXPECTED_NAME=${{Postgres.PGDATABASE}}
DB_EXPECTED_NAME=nacao-animal
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres

# Railway pode usar DATABASE_URL no lugar das variaveis DB_* acima.
DATABASE_URL=
POSTGRES_URL=
DATABASE_PUBLIC_URL=
DB_SSL=false

# ==================================================
# AUTENTICACAO
# ==================================================

JWT_SECRET=troque_por_uma_chave_forte_e_grande
JWT_EXPIRES_IN=7d

# ==================================================
# ADMIN PADRAO PARA SEED
# ==================================================

ADMIN_NAME=Administrador
ADMIN_EMAIL=
# Minimo de 12 caracteres com maiuscula, minuscula, numero e simbolo.
ADMIN_PASSWORD=

# ==================================================
# CLOUDINARY
# ==================================================

CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# Limite de upload em bytes (inteiro positivo, ate 20 MB). Padrao: 5 MB.
MAX_FILE_SIZE=5242880

# ==================================================
# RESEND / EMAIL
# ==================================================

RESEND_API_KEY=sua_chave_resend
# Preencher depois da definicao do e-mail da loja e verificacao no Resend.
EMAIL_FROM=
# Destinatario opcional para testes autorizados.
EMAIL_TEST_TO=

# ==================================================
# PAGAMENTOS ONLINE - AGUARDANDO DEFINICAO / HOMOLOGACAO
# ==================================================

# Mantenha desativado. Preencher credenciais nao implementa a integracao.
# Consulte docs/pagamentos-itau.md antes de configurar qualquer provedor.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=pending
PAYMENT_ENVIRONMENT=sandbox

# e.Rede: apenas se o banco confirmar essa solucao.
# Client ID corresponde ao PV; Client Secret corresponde a chave de integracao.
REDE_CLIENT_ID=
REDE_CLIENT_SECRET=

# Pix direto no Itau: apenas se esse produto for contratado.
ITAU_PIX_CLIENT_ID=
ITAU_PIX_CLIENT_SECRET=
ITAU_PIX_RECEIVER_KEY=
# Caminhos privados no servidor; nunca colocar certificados/chaves em public/.
ITAU_PIX_CERT_PATH=
ITAU_PIX_PRIVATE_KEY_PATH=

# Nao guardar access_token temporario aqui; a futura integracao cuidara dele.
# Adaptador PagBank herdado, inativo nesta instalacao.
PAGSEGURO_BASE_URL=
PAGSEGURO_TOKEN=

# FRETE: Google Maps Platform, Routes API habilitada, chave apenas no servidor.
GOOGLE_MAPS_API_KEY=
DELIVERY_ORIGIN_ADDRESS=Avenida Novo Horizonte, 256, Vila Sacadura Cabral, Santo André, SP, 09060-820, Brasil

# Chave publica restrita ao dominio; habilite Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=

# Tempo em que os itens ficam reservados enquanto o pagamento nao termina.
ORDER_RESERVATION_MINUTES=30

# Depois que sair para entrega, o cancelamento automatico so e permitido acima desta distancia do destino.
CANCELLATION_MIN_DISTANCE_METERS=1000
# O cancelamento e estorno automaticos sao limitados a 24 horas por regra do sistema.
